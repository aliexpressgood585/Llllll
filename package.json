{
  "name": "nexus-quant-options-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "High-aggression crypto options trading desk simulator (React + TypeScript + Tailwind + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:soak": "tsx scripts/headless.ts",
    "paper": "tsx scripts/paper-live.ts",
    "test:live": "tsx scripts/live-fixture.ts 12",
    "bot": "tsx bot/index.ts",
    "test:bot": "tsx scripts/bot-fixture.ts",
    "report": "tsx bot/report-cli.ts",
    "office:dev": "vite --config office/vite.config.ts",
    "office:typecheck": "tsc --noEmit -p office/tsconfig.json",
    "office:build": "tsc --noEmit -p office/tsconfig.json && vite build --config office/vite.config.ts && python3 office/build-artifact.py",
    "futures": "tsx futures/index.ts",
    "test:futures": "tsx scripts/futures-fixture.ts",
    "futures:report": "tsx futures/report-cli.ts",
    "futures:demo": "tsx futures/demo.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}

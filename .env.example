# Data source: "live" (default: Deribit + Binance public market data, paper trading) or "sim" (synthetic market)
VITE_DATA_SOURCE=live

# ---- Binance options bot (npm run bot) ----
BOT_CAPITAL=2500                # fixed portfolio in USDT, never topped up
BOT_MODE=paper                  # paper = real Binance data + simulated fills on the real order book; live = real orders
BOT_UNDERLYINGS=BTCUSDT,ETHUSDT,SOLUSDT
RISK_PER_TRADE=0.05             # max premium per new position (fraction of equity)
RISK_MAX_OPEN=0.35              # max premium open at once
RISK_MAX_POSITIONS=5
RISK_DAILY_LOSS=0.08            # no new entries for the rest of the UTC day after this loss
RISK_MAX_DD=0.30                # halt new entries after this drawdown from peak (manual resume)
RISK_MAX_SPREAD=0.10            # skip contracts with a wider bid/ask spread
RISK_MAX_SLIPPAGE=0.03          # IOC limit = best price ± 3%
EXIT_TP=0.6
EXIT_SL=0.45
# live mode only — keys need Options trading permission; keep BOT_HOST=127.0.0.1
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_CONFIRM=                   # must be I_ACCEPT_REAL_MONEY_RISK to enable real orders
